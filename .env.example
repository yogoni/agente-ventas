# Cada estudiante usa su propia clave de OpenRouter.
OPENROUTER_API_KEY=

# Puerto de servicio en el aula: studentNN -> 81NN
# (student01 -> 8101, student12 -> 8112). En local, 8000.
SERVICE_PORT=

# LangSmith: registra las trazas y el feedback 👍/👎.
# Sin clave la app funciona, pero los botones de feedback devuelven 503.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-ventas
# Región de tu cuenta: EU -> https://eu.api.smith.langchain.com
# (sin esta línea se usa la de EE. UU. y las claves EU dan 403)
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
